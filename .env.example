# Rec League Manager: optional settings
#
# Nothing in this file is required. The app runs with the defaults shown here.
# To change a setting, copy this file to .env in the same folder and edit the copy:
#   Windows PowerShell:      Copy-Item .env.example .env
#   WSL, Linux, or macOS:    cp .env.example .env
# .env is listed in .gitignore, so it is never committed.
#
# SQLite has no usernames, passwords, or server address, so there are no
# database credentials to set.

# SQLite database file the app and init_db.py use.
# A relative path starts in the project folder.
REC_LEAGUE_DB=rec_league.db

# Port for the web app. Change it if 5050 is already in use.
# The app is then at http://127.0.0.1:PORT
PORT=5050

# Key Flask uses to sign the short success and error messages shown after a
# form is saved. Leave it blank and the app makes a random key each time it starts.
# If you do set one, use your own random value and never commit it.
SECRET_KEY=
